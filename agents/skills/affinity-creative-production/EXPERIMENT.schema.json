{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialmarket.local/schemas/affinity-page-experiment.schema.json",
  "title": "AFFINITY Page Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "experiment_id",
    "parent_page_id",
    "variants",
    "primary_hypothesis",
    "primary_metric",
    "guardrail_metrics",
    "assignment",
    "seo_strategy",
    "measurement",
    "decision_policy"
  ],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "experiment_id": {"type": "string", "minLength": 3},
    "parent_page_id": {"type": "string", "minLength": 3},
    "primary_hypothesis": {"type": "string", "minLength": 10},
    "hypothesis_class": {
      "type": "string",
      "enum": [
        "product_offer",
        "audience_use_case",
        "angle_message_match",
        "hero_proposition",
        "economic_framing",
        "proof_type_order",
        "cta",
        "component_sequence",
        "media_treatment",
        "styling_detail"
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "weight", "locked_fields", "changed_fields"],
        "properties": {
          "variant_id": {"type": "string"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "locked_fields": {"type": "array", "items": {"type": "string"}},
          "changed_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "angle_id": {"type": ["string", "null"]},
          "archetype": {"type": ["string", "null"]},
          "component_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "primary_metric": {"type": "string", "default": "RPV"},
    "guardrail_metrics": {"type": "array", "items": {"type": "string"}},
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "sticky", "exclude_bots"],
      "properties": {
        "method": {"type": "string", "enum": ["deterministic_hash", "server_assignment", "platform_assignment"]},
        "sticky": {"type": "boolean"},
        "exclude_bots": {"type": "boolean"},
        "unit": {"type": "string", "enum": ["visitor", "session", "account", "campaign"]}
      }
    },
    "seo_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indexing", "canonical_strategy"],
      "properties": {
        "indexing": {"type": "string", "enum": ["single_indexable_control", "canonicalized_variants", "noindex_variants", "platform_managed"]},
        "canonical_strategy": {"type": "string"},
        "hreflang_notes": {"type": ["string", "null"]}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_window", "measurement_window", "minimum_sample_policy", "segment_dimensions"],
      "properties": {
        "baseline_window": {"type": "string"},
        "measurement_window": {"type": "string"},
        "minimum_sample_policy": {"type": "string"},
        "segment_dimensions": {"type": "array", "items": {"type": "string"}},
        "start_at": {"type": ["string", "null"]},
        "end_at": {"type": ["string", "null"]}
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomes", "avoid_early_winner_claims"],
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {"type": "string", "enum": ["KEEP", "ITERATE", "ROLLBACK", "INSUFFICIENT_DATA"]}
        },
        "avoid_early_winner_claims": {"type": "boolean", "const": true},
        "practical_significance_rule": {"type": ["string", "null"]},
        "confidence_rule": {"type": ["string", "null"]}
      }
    },
    "rollback_reference": {"type": ["string", "null"]}
  }
}
