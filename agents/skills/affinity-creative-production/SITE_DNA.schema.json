{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialmarket.local/schemas/affinity-site-dna.schema.json",
  "title": "AFFINITY Site DNA",
  "description": "Site-level architecture that composes multiple Page DNA objects under one brand, navigation, conversion and analytics system.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "site_id",
    "site_type",
    "market",
    "locales",
    "primary_objective",
    "brand_store_dna_ref",
    "information_architecture",
    "navigation",
    "routes",
    "global_components",
    "conversion_paths",
    "seo",
    "analytics",
    "qa"
  ],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "site_id": {"type": "string", "minLength": 3},
    "site_type": {
      "type": "string",
      "enum": [
        "single-product-brand",
        "multi-product-dtc",
        "affiliate-content-commerce",
        "campaign-microsite",
        "lead-generation-site",
        "saas-marketing-site",
        "professional-service-site",
        "editorial-commerce-hub",
        "custom"
      ]
    },
    "market": {"type": "string"},
    "locales": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "currency": {"type": ["string", "null"]},
    "primary_objective": {
      "type": "string",
      "enum": ["affiliate_revenue", "ecommerce_revenue", "lead_generation", "book_meetings", "content_to_commerce", "mixed"]
    },
    "brand_store_dna_ref": {"type": "string"},
    "information_architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_model", "taxonomy", "user_journeys"],
      "properties": {
        "content_model": {"type": "array", "items": {"type": "string"}},
        "taxonomy": {"type": "array", "items": {"type": "string"}},
        "user_journeys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "entry", "goal", "path"],
            "properties": {
              "id": {"type": "string"},
              "entry": {"type": "string"},
              "audience": {"type": ["string", "null"]},
              "goal": {"type": "string"},
              "path": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header_model", "primary_items", "footer_groups"],
      "properties": {
        "header_model": {"type": "string", "enum": ["minimal", "standard", "mega-menu", "campaign-minimal"]},
        "primary_items": {"type": "array", "items": {"type": "string"}},
        "utility_items": {"type": "array", "items": {"type": "string"}},
        "footer_groups": {"type": "array", "items": {"type": "string"}},
        "search_enabled": {"type": "boolean"},
        "cart_enabled": {"type": "boolean"}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "page_type", "purpose", "page_dna_ref", "indexing"],
        "properties": {
          "route": {"type": "string"},
          "page_type": {
            "type": "string",
            "enum": [
              "home",
              "landing",
              "product",
              "collection",
              "category",
              "comparison",
              "buying-guide",
              "article",
              "lead-magnet",
              "about",
              "contact",
              "faq",
              "trust",
              "search",
              "cart",
              "legal",
              "custom"
            ]
          },
          "purpose": {"type": "string"},
          "page_dna_ref": {"type": "string"},
          "layout_dna_ref": {"type": ["string", "null"]},
          "parent_route": {"type": ["string", "null"]},
          "indexing": {"type": "string", "enum": ["index", "noindex", "conditional"]},
          "canonical_route": {"type": ["string", "null"]},
          "priority": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }
    },
    "global_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "scope"],
        "properties": {
          "component_id": {"type": "string"},
          "scope": {"type": "string", "enum": ["all", "commerce", "content", "campaign", "selected_routes"]},
          "routes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "conversion_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entry_routes", "target_action", "supporting_routes"],
        "properties": {
          "id": {"type": "string"},
          "entry_routes": {"type": "array", "items": {"type": "string"}},
          "target_action": {"type": "string"},
          "supporting_routes": {"type": "array", "items": {"type": "string"}},
          "handoff_destination": {"type": ["string", "null"]}
        }
      }
    },
    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owned_checkout": {"type": "boolean"},
        "product_catalog": {"type": "boolean"},
        "collections": {"type": "boolean"},
        "cart_drawer": {"type": "boolean"},
        "upsells": {"type": "boolean"},
        "affiliate_handoff": {"type": "boolean"}
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_policy", "sitemap", "robots", "internal_linking_model"],
      "properties": {
        "canonical_policy": {"type": "string"},
        "sitemap": {"type": "boolean"},
        "robots": {"type": "string"},
        "internal_linking_model": {"type": "string"},
        "hreflang": {"type": "boolean"},
        "structured_data_policy": {"type": ["string", "null"]}
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "global_events"],
      "properties": {
        "primary_metric": {"type": "string"},
        "global_events": {"type": "array", "items": {"type": "string"}},
        "journey_ids": {"type": "array", "items": {"type": "string"}},
        "site_experiment_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_engine_required", "global_navigation_check", "broken_link_check", "cross_route_design_consistency", "rollback_required"],
      "properties": {
        "page_engine_required": {"type": "boolean", "const": true},
        "global_navigation_check": {"type": "boolean", "const": true},
        "broken_link_check": {"type": "boolean", "const": true},
        "cross_route_design_consistency": {"type": "boolean", "const": true},
        "rollback_required": {"type": "boolean", "const": true}
      }
    }
  }
}
