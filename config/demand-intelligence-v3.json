{
  "version": "demand_intelligence_v3",
  "autonomy": {
    "mode": "autonomous_by_default",
    "user_override": true,
    "allowed": ["query_planning", "retrieval_depth", "source_expansion", "analyst_routing", "fuzzy_state_classification", "challenger_model_selection", "presentation_scene_selection"],
    "forbidden": ["overwrite_canonical_metrics", "coerce_missing_to_zero", "relax_validation_gates", "promote_unbacktested_forecast", "invent_search_volume", "invent_paid_ad_metrics"]
  },
  "retrieval": {
    "strategy": "hybrid_rag",
    "components": ["direct_taxonomy", "postgres_fts", "pg_trgm_fuzzy", "vector_when_query_embedding_available", "recency", "authority", "confidence"],
    "max_evidence": 120,
    "weights": {"direct": 0.35, "fts": 0.20, "fuzzy": 0.15, "confidence": 0.10, "recency": 0.10, "authority": 0.10},
    "source_authority": {"statistics.gr": 1.0, "ec.europa.eu": 1.0, "eurostat.ec.europa.eu": 1.0, "greekecommerce.gr": 0.82, "default": 0.58}
  },
  "fuzzy_fusion": {
    "purpose": "analytical state classification only",
    "canonical_scores_immutable": true,
    "states": ["validated_unmet_need", "whitespace", "emerging", "crowded_demand", "balanced", "uncertain"]
  },
  "forecast": {
    "mode": "shadow_until_backtested",
    "minimum_points": 90,
    "minimum_span_days": 30,
    "minimum_backtest_windows": 3,
    "promotion_rule": "challenger must beat naive baseline out-of-sample and preserve calibrated uncertainty",
    "baselines": ["naive", "drift", "rolling_mean"],
    "challengers": ["NHITS", "NBEATSx", "PatchTST", "TFT", "TimesFM", "Chronos2"],
    "tooling": ["Nixtla/NeuralForecast", "unit8co/darts", "Nixtla/hierarchicalforecast", "google-research/timesfm", "amazon-science/chronos-forecasting"]
  },
  "greek_market_context": {
    "sources": ["ELSTAT_Retail", "ELSTAT_HBS", "ELSTAT_ICT", "Eurostat_Digital", "GRECA_Research"],
    "rule": "macro and industry series are exogenous context unless the measure directly observes the category; they never become search volume by inference"
  },
  "supply_correlation": {
    "sources": ["api.merchant_gap_rankings", "api.merchant_rankings", "Linkwise_network_baselines"],
    "rule": "supply context may explain opportunity tension but must not rewrite demand"
  },
  "presentation": {
    "style": "kimi_like_executive_storytelling",
    "scene_order": ["thesis", "market_state", "evidence_stack", "greek_context", "demand_supply_tension", "contradictions", "history", "forecast_lab", "actions", "falsification"],
    "labels": ["OBSERVED", "DERIVED", "MODELED", "WITHHELD"]
  }
}
